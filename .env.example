APP_ENV=dev
APP_URL=http://localhost:8000

# Włącz dopiero przy publikacji pod właściwą domeną klubu.
APP_INDEXING_ENABLED=false
# Same nazwy hostów, oddzielone przecinkami, bez https:// i ścieżek.
# Przykład formatu: example.com,www.example.com. Pusta lista blokuje indeksowanie.
APP_INDEXING_HOSTS=

# Obsługa starych adresów. Lokalnie pozostaw false poza sprawdzaniem przekierowań.
LEGACY_REDIRECTS_ENABLED=false

DB_HOST=db
DB_DATABASE=karate
DB_USERNAME=user_karate
DB_PASSWORD=haslo

MAILER_DSN='smtp://mailpit:1025?auto_tls=false'
MAIL_FROM_EMAIL=powiadomienia@example.test
